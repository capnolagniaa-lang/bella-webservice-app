# Copiá este archivo como .streamlit/secrets.toml (no se sube a git)
# o cargá el mismo valor en "Secrets" de Streamlit Cloud / "Environment" de Render.
# Usá la "External Database URL" que muestra Render en el panel de la base.
DATABASE_URL = "postgresql://USUARIO:CONTRASEÑA@HOST.virginia-postgres.render.com/NOMBRE_BASE"
